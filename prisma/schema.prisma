generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  subsidiary
  admin
  delivery
  viewer
}

enum OrgStatus {
  active
  inactive
}

enum DemandStatus {
  SUBMITTED   // 需求提出
  PRD_REVIEW  // PRD確認中
  SP_REVIEW   // SP確認中
  DEVELOPING  // 開發中
  ACCEPTANCE  // 驗收中
  CLOSED      // 已結案
  REJECTED    // 已駁回
  ON_HOLD     // 暫緩
  CANCELLED   // 已取消（軟取消，保留記錄、釋放 SP，可重新啟動）
}

/// 設計變更 / 逐條回應狀態
enum DesignChangeStatus {
  PENDING    // 待確認
  APPROVED   // 已通過
  REJECTED   // 已駁回
  CANCELLED  // 已撤回
}

/// 需求方對 checklist 每一條的標記
enum ChecklistMark {
  PENDING    // 尚未回應
  CONFIRMED  // 勾選：確認沒問題
  CROSS      // 叉叉：有問題
  WARN       // 驚嘆號：有疑慮
}

enum DemandPriority {
  low
  medium
  high
  critical
}

enum DocumentType {
  MEETING_NOTES       // 會議記錄
  PRD                 // 需求規格書
  SDD                 // 系統設計文件
  TEST_REPORT         // 測試報告
  ATTACHMENT          // 一般附件
  BDD                 // 行為驅動開發文件
  TDD                 // 測試驅動開發文件
  MODULE_ARCHITECTURE // 模組架構文件
  SP_PLAN             // SP 規劃文件
  APP_RESULT          // APP 交付成果
  GITHUB_REPO         // GitHub 連結
  AUDIO               // 音訊
  VIDEO               // 影片
  SECURITY_REPORT     // 資安報告
  SECURITY_FIX_REPORT // 資安修正報告
  OPERATION_MANUAL    // 操作手冊
  ZHIHE_QUOTE         // 智合報價單（僅管理者/董事會可見，審核通過後才可下載）
}

enum SubTaskStatus {
  pending
  in_progress
  completed
}

enum SpTransactionType {
  QUOTA  // 年度配額發放
  COMMIT // 承諾 (進入開發時)
  DEDUCT // 扣除 (驗收通過時)
  ADJUST // 調整
  REFUND // 退還 (需求取消時)
}

enum NotificationType {
  DEMAND_STATUS // 需求狀態變更
  ACCEPTANCE    // 驗收通知
  SP_CHANGE     // SP變動
  SYSTEM        // 系統通知
  SIGNOFF       // 簽核通知
  DOCUMENT      // 文件通知
  COMMENT       // 討論通知
  ASSIGNMENT    // 指派通知
}

enum AcceptanceResult {
  PASS
  REJECT
}

enum SignoffStatus {
  PENDING    // 待確認
  APPROVED   // 已確認
  REJECTED   // 已退回
  SKIPPED    // 管理者略過
  CANCELLED  // 發起者撤回（目前僅限設計變更）
}

enum DemandSignoffRole {
  REQUESTER   // 需求者
  MANAGER     // 主管
  BOARD       // 董事會（開案審核）
  OBSERVER    // 觀察者（只能看）
}

enum MailLogType {
  SIGNOFF_NOTIFY  // 簽核通知
  MONTHLY_REPORT  // 月度 SP 報表
}

enum MailLogStatus {
  SUCCESS
  FAILED
}

// ============================================================
// MODELS
// ============================================================

/// 子公司 / 組織
model Organization {
  id        String    @id @default(cuid())
  code      String    @unique /// e.g. "panjit", "hge"
  name      String /// e.g. "強茂"
  fullName  String? /// e.g. "強茂股份有限公司"
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users        User[]
  demands      Demand[]
  spWallets    SpWallet[]
  adminAccess  AdminAccess[]
  emailSetting EmailSetting?

  @@map("organizations")
}

/// 使用者
model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  password       String        @default("") /// bcrypt hashed (空 = 僅 LDAP 登入)
  role           UserRole
  avatarUrl      String?       @db.Text
  isActive       Boolean       @default(true)
  isBoardMember          Boolean       @default(false) @map("is_board_member")           /// 董事會成員（全域 SP_REVIEW 審核權）
  restrictBoardToOrg     Boolean       @default(false) @map("restrict_board_to_org")     /// true = 僅能審核自己組織的專案
  restrictBoardViewToOrg Boolean       @default(false) @map("restrict_board_view_to_org") /// true = 僅能查看自己組織的專案
  boardExemptFromSignoff Boolean       @default(false) @map("board_exempt_from_signoff") /// true = 不需要參與開案審核
  canViewFinancial       Boolean       @default(false) @map("can_view_financial")         /// true = 可查看金額報表
  canViewSpTransfer      Boolean       @default(false) @map("can_view_sp_transfer")        /// true = 可查看「智合移轉強合授權 SP」與報價單
  isOrgAccount           Boolean       @default(false) @map("is_org_account")            /// 組織帳號（唯讀，不可簽核）
  adminScopeType         String        @default("all") @map("admin_scope_type")          /// "all" | "organization" | "project"
  managerCompany         String?       @map("manager_company")                            /// 管理者所屬公司："QIANGHE"(強合) | "ZHIHE"(智合)，供報價單審核區分
  ldapUsername    String?       /// AD 工號 (e.g. 90770)
  ldapDomain     String?       /// AD domain (e.g. PANJIT)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  submittedDemands  Demand[]          @relation("DemandSubmitter")
  managedDemands    Demand[]          @relation("DemandManager")
  developedDemands  Demand[]          @relation("DemandDeveloper")
  createdDemands    Demand[]          @relation("DemandCreator")
  contactDemands    Demand[]          @relation("DemandContactPerson")
  demandManagerDemands Demand[]       @relation("DemandDemandManager")
  notifications     Notification[]
  demandComments    DemandComment[]
  acceptanceRecords AcceptanceRecord[]
  phasePlanEngineer DemandPhasePlan[] @relation("PhasePlanEngineer")
  phasePlanPM       DemandPhasePlan[] @relation("PhasePlanPM")
  subTaskAssignee   DemandSubTask[]   @relation("SubTaskAssignee")
  demandAccessGrants DemandAccess[]
  adminAccessGrants  AdminAccess[]
  signoffRequests    PhaseSignoff[]  @relation("SignoffRequester")
  signoffResponses   PhaseSignoff[]  @relation("SignoffResponder")
  signoffTargets     PhaseSignoff[]  @relation("SignoffTarget")
  designChangesCreated   DesignChange[]             @relation("DCCreator")
  designRevSubmitted     DesignChangeRevision[]     @relation("DCRevSubmitter")
  designItemFeedback     DesignChangeItemFeedback[] @relation("DCItemReviewer")
  designReviews          DesignChangeReview[]       @relation("DCReviewer")
  designDocsUploaded     DesignChangeDocument[]     @relation("DCDocUploader")
  createdShares      DemandShare[]
  quoteReviews       Demand[]        @relation("QuoteReviewer")
  auditLogs          AuditLog[]
  sentMailLogs       MailLog[]
  apiKeys            ApiKey[]

  @@map("users")
}

/// SP 錢包 (每組織每年)
model SpWallet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  year           Int /// e.g. 2024
  vendor         String       @default("JV") /// 開發商名稱
  totalQuota     Int /// 年度 SP 配額
  usedSp         Int          @default(0) /// 已扣除 (驗收完成)
  committedSp    Int          @default(0) /// 已承諾 (開發中)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions SpTransaction[]

  @@unique([organizationId, year, vendor])
  @@map("sp_wallets")
}

/// SP 交易紀錄
model SpTransaction {
  id          String            @id @default(cuid())
  walletId    String
  wallet      SpWallet          @relation(fields: [walletId], references: [id])
  type        SpTransactionType
  amount      Int /// 正數為入帳, 負數為扣除
  balance     Int /// 交易後餘額
  description String            @db.Text
  demandId    String?
  demand      Demand?           @relation(fields: [demandId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([walletId])
  @@map("sp_transactions")
}

/// 需求 (核心實體)
model Demand {
  id              String         @id @default(cuid())
  demandNumber    String         @unique /// REQ-YYYY-NNN 自動產生
  title           String
  description     String         @db.Text
  painPoint       String?        @db.Text /// 痛點說明
  expectedBenefit String?        @db.Text /// 預期效益
  status          DemandStatus   @default(SUBMITTED)
  priority        DemandPriority @default(medium)
  estimatedSp     Float /// 初步 SP 估點
  confirmedSp     Float? /// CEO 確認 SP
  desiredDate     DateTime? /// 希望完成時間
  expectedDate    DateTime? /// 預計完成時間
  completedDate   DateTime? /// 實際完成時間
  isTerminated    Boolean        @default(false) /// 經專案 Master 代簽直接結案 → 客戶認知為「已終止」（狀態仍為 CLOSED）
  // ── 智合抽成（內部：僅管理者/董事會可見）──
  zhiheSpTaken      Float? /// 智合自本專案抽取的 SP（選填，通常結案才記錄）
  zhiheSpNote       String?   @db.Text /// 抽成說明
  quoteReviewedById String? /// 報價單審核通過者（強合管理者）
  quoteReviewedBy   User?     @relation("QuoteReviewer", fields: [quoteReviewedById], references: [id])
  quoteReviewedAt   DateTime? /// 報價單審核通過時間
  rejectReason    String?        @db.Text
  holdReason      String?        @db.Text /// 暫緩原因
  vendor          String         @default("JV") /// 開發商名稱
  heldFromStatus  String? /// 暫緩/駁回前的階段（用於 SP 計算）
  adminNotes      String?        @db.Text /// 管理者備註 (內部)
  contactPersonId String? /// 需求窗口 (從 DemandAccess REQUESTER 中選)
  contactPerson_  User?          @relation("DemandContactPerson", fields: [contactPersonId], references: [id])
  demandManagerId String? /// 需求主管 (從 DemandAccess MANAGER 中選)
  demandManager   User?          @relation("DemandDemandManager", fields: [demandManagerId], references: [id])
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  submitterId     String
  submitter       User           @relation("DemandSubmitter", fields: [submitterId], references: [id])
  creatorId       String /// 建立者 (可能是管理者代建)
  creator         User           @relation("DemandCreator", fields: [creatorId], references: [id])
  managerId       String? /// PM / 管理者
  manager         User?          @relation("DemandManager", fields: [managerId], references: [id])
  developerId     String? /// 開發者
  developer       User?          @relation("DemandDeveloper", fields: [developerId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  statusHistory     DemandStatusHistory[]
  documents         DemandDocument[]
  comments          DemandComment[]
  spTransactions    SpTransaction[]
  acceptanceRecords AcceptanceRecord[]
  phasePlans        DemandPhasePlan[]
  subTasks          DemandSubTask[]
  accessGrants      DemandAccess[]
  adminAccessGrants AdminAccess[]
  phaseSignoffs     PhaseSignoff[]
  designChanges     DesignChange[]
  shares            DemandShare[]
  auditLogs         AuditLog[]
  mailLogs          MailLog[]
  prototypes        Prototype[]

  @@index([organizationId])
  @@index([status])
  @@index([submitterId])
  @@map("demands")
}

/// MVP 原型（可上傳一組 HTML 畫面供客戶互動預覽，分版本）
model Prototype {
  id         String            @id @default(cuid())
  demandId   String
  demand     Demand            @relation(fields: [demandId], references: [id], onDelete: Cascade)
  version    Int /// 版本號（同一需求內遞增）
  note       String?           @db.Text /// 版本說明
  uploadedBy String /// user id
  createdAt  DateTime          @default(now())
  screens    PrototypeScreen[]

  @@index([demandId])
  @@map("prototypes")
}

/// 原型的單一畫面（一個 HTML 檔 + 選填截圖）
model PrototypeScreen {
  id             String    @id @default(cuid())
  prototypeId    String
  prototype      Prototype @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  name           String /// 畫面名稱（取自檔名）
  order          Int       @default(0)
  htmlFile       String /// 網頁版 HTML 檔名（uploads/demands/[demandId]/）
  htmlFileMobile String? /// 選填手機版 HTML 檔名（來源資料夾名 _mobile）
  screenshotFile String? /// 選填截圖檔名
  createdAt      DateTime  @default(now())

  @@index([prototypeId])
  @@map("prototype_screens")
}

/// 需求狀態變更歷史
model DemandStatusHistory {
  id         String        @id @default(cuid())
  demandId   String
  demand     Demand        @relation(fields: [demandId], references: [id], onDelete: Cascade)
  fromStatus DemandStatus?
  toStatus   DemandStatus
  comment    String?       @db.Text
  changedBy  String /// user ID or name
  createdAt  DateTime      @default(now())

  @@index([demandId])
  @@map("demand_status_history")
}

/// 需求文件 (會議記錄, PRD, SDD, 測試報告等)
model DemandDocument {
  id         String        @id @default(cuid())
  demandId   String
  demand     Demand        @relation(fields: [demandId], references: [id], onDelete: Cascade)
  type       DocumentType
  phase      DemandStatus? /// 文件所屬階段
  fileName   String
  fileUrl    String?       @db.Text
  fileSize   Int? /// bytes
  uploadedBy String /// user ID or name
  createdAt  DateTime      @default(now())
  signoffId  String? /// 簽核附件
  signoff    PhaseSignoff? @relation(fields: [signoffId], references: [id], onDelete: SetNull)

  // ── 版本化 ──
  version        Int           @default(1) /// 版本號（同 docGroup 內遞增）
  docGroup       String? /// 版本群組 id（同一份邏輯文件的多版本共用；null = 舊資料/獨立檔）
  changeNote     String?       @db.Text /// 此版本的更新說明（為什麼更新）
  designChangeId String? /// 選填：此版本由哪個設計變更造成
  designChange   DesignChange? @relation("DocDesignChange", fields: [designChangeId], references: [id], onDelete: SetNull)

  @@index([demandId])
  @@index([demandId, phase])
  @@index([docGroup])
  @@map("demand_documents")
}

/// 需求討論 / 備註
model DemandComment {
  id         String   @id @default(cuid())
  demandId   String
  demand     Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String   @db.Text
  isInternal Boolean  @default(false) /// 管理者內部備註
  createdAt  DateTime @default(now())

  @@index([demandId])
  @@map("demand_comments")
}

/// 驗收記錄
model AcceptanceRecord {
  id           String           @id @default(cuid())
  demandId     String
  demand       Demand           @relation(fields: [demandId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User             @relation(fields: [reviewerId], references: [id])
  result       AcceptanceResult
  rating       Int? /// 1-5 stars
  feedback     String?          @db.Text
  rejectReason String?          @db.Text
  workUrl      String?          @db.Text /// demo/production URL
  giteaUrl     String?          @db.Text /// git repository URL
  checkItems   Json? /// [{id, label, checked}]
  createdAt    DateTime         @default(now())

  @@index([demandId])
  @@map("acceptance_records")
}

/// 通知
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  linkUrl   String? /// deep link
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

/// 操作紀錄 (統一審計日誌)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String /// CREATE, UPDATE, DELETE, STATUS_CHANGE, SIGNOFF_REQUEST, SIGNOFF_APPROVE, SIGNOFF_REJECT, UPLOAD, ASSIGN, GRANT, REVOKE
  entity    String /// DEMAND, DOCUMENT, SIGNOFF, SUB_TASK, COMMENT, USER, ORGANIZATION, SHARE, ACCESS
  entityId  String
  demandId  String?
  demand    Demand?  @relation(fields: [demandId], references: [id], onDelete: SetNull)
  details   String?  @db.Text /// JSON metadata (old/new values, context)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([demandId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

/// 需求階段規劃
model DemandPhasePlan {
  id           String        @id @default(cuid())
  demandId     String
  demand       Demand        @relation(fields: [demandId], references: [id], onDelete: Cascade)
  phase        DemandStatus
  plannedSp    Float? /// 該階段規劃 SP (調整後)
  originalPlannedSp Float? /// 調整前原始 SP 分配
  plannedStart DateTime? /// 計畫開始
  plannedEnd   DateTime? /// 計畫結束
  actualStart  DateTime? /// 實際開始
  actualEnd    DateTime? /// 實際結束
  engineerId   String? /// 工程師 (MVP 階段後)
  engineer     User?         @relation("PhasePlanEngineer", fields: [engineerId], references: [id])
  pmId         String? /// PM (MVP 階段後)
  pm           User?         @relation("PhasePlanPM", fields: [pmId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([demandId, phase])
  @@index([demandId])
  @@map("demand_phase_plans")
}

/// 需求子任務 (開發甘特圖)
model DemandSubTask {
  id           String        @id @default(cuid())
  demandId     String
  demand       Demand        @relation(fields: [demandId], references: [id], onDelete: Cascade)
  name         String /// e.g. "前端開發", "後端開發"
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  status       SubTaskStatus @default(pending)
  assigneeId   String?
  assignee     User?         @relation("SubTaskAssignee", fields: [assigneeId], references: [id])
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([demandId])
  @@map("demand_sub_tasks")
}

/// 需求可見權限 + 每專案審核角色 (管理員手動授權)
model DemandAccess {
  id          String            @id @default(cuid())
  demandId    String
  demand      Demand            @relation(fields: [demandId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   String /// 授權者 user ID
  signoffRole DemandSignoffRole @default(OBSERVER) /// 在該專案擔任的審核角色
  createdAt   DateTime          @default(now())

  @@unique([demandId, userId])
  @@index([userId])
  @@index([demandId])
  @@map("demand_access")
}

/// 管理員權限範圍（依組織或依專案，搭配 User.adminScopeType）
model AdminAccess {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  demandId       String?
  demand         Demand?       @relation(fields: [demandId], references: [id], onDelete: Cascade)
  permission     String        @default("view") /// "view" | "edit"
  grantedBy      String /// 授權者 user ID
  createdAt      DateTime      @default(now())

  @@unique([userId, organizationId])
  @@unique([userId, demandId])
  @@index([userId])
  @@map("admin_access")
}

/// 階段簽核 (需求者背書確認) / 設計變更 (kind = DESIGN_CHANGE)
model PhaseSignoff {
  id            String        @id @default(cuid())
  demandId      String
  demand        Demand        @relation(fields: [demandId], references: [id], onDelete: Cascade)
  phase         DemandStatus
  kind          String        @default("PHASE") /// "PHASE" (階段簽核) | "DESIGN_CHANGE" (設計變更)
  status        SignoffStatus @default(PENDING)
  targetUserId  String?       /// 指定簽核人 (null = 舊資料, 任何有權限的人可簽)
  targetUser    User?         @relation("SignoffTarget", fields: [targetUserId], references: [id])
  targetRole    String?       /// 簽核角色 (REQUESTER / MANAGER / BOARD)
  overrideTargetStatus DemandStatus? /// 代簽通過後直接結算至此狀態 (僅 BOARD_OVERRIDE，null = 不直接結算，照正常流程)
  comment        String?       @db.Text
  requestComment String?       @db.Text @map("request_comment")
  requestedAt    DateTime      @default(now())
  respondedAt   DateTime?
  requestedById String
  requestedBy   User          @relation("SignoffRequester", fields: [requestedById], references: [id])
  respondedById String?
  respondedBy   User?         @relation("SignoffResponder", fields: [respondedById], references: [id])
  documents     DemandDocument[]

  @@index([demandId])
  @@index([demandId, phase])
  @@index([demandId, kind])
  @@index([status])
  @@map("phase_signoffs")
}

/// 設計變更主體（一個變更主題，可反覆修訂累積版本 v1/v2/v3）
model DesignChange {
  id             String             @id @default(cuid())
  demandId       String
  demand         Demand             @relation(fields: [demandId], references: [id], onDelete: Cascade)
  seq            Int                /// 需求內序號 → DC-01, DC-02
  title          String
  phase          DemandStatus       /// 提出時所在階段
  status         DesignChangeStatus @default(PENDING) /// 追隨最新版本狀態
  currentVersion Int                @default(1)
  createdById    String
  createdBy      User               @relation("DCCreator", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  revisions      DesignChangeRevision[]
  docVersions    DemandDocument[]   @relation("DocDesignChange") /// 因此設計變更而更新的文件版本

  @@unique([demandId, seq])
  @@index([demandId])
  @@map("design_changes")
}

/// 設計變更版本（每次送出/修訂 = 一個版本，保留當時快照）
model DesignChangeRevision {
  id             String             @id @default(cuid())
  designChangeId String
  designChange   DesignChange       @relation(fields: [designChangeId], references: [id], onDelete: Cascade)
  version        Int
  summary        String             @db.Text /// 變更摘要說明 (Markdown)
  checklistMd    String?            @db.Text /// checklist 原始 Markdown
  affectsSp      Boolean            @default(false) /// 是否影響 SP → 需董事會加入審核
  spCurrent      Float?             /// 提出當下的 SP（快照，供董事會評估）
  spDelta        Float?             /// 預計增減 SP（正=上調，負=下降）
  spNote         String?            @db.Text /// SP 影響補充說明
  status         DesignChangeStatus @default(PENDING)
  submittedById  String
  submittedBy    User               @relation("DCRevSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime           @default(now())
  decidedAt      DateTime?
  items          DesignChangeChecklistItem[]
  reviews        DesignChangeReview[]
  documents      DesignChangeDocument[]

  @@unique([designChangeId, version])
  @@index([designChangeId])
  @@map("design_change_revisions")
}

/// checklist 逐條（由貼上的 Markdown 拆解而成）
model DesignChangeChecklistItem {
  id         String   @id @default(cuid())
  revisionId String
  revision   DesignChangeRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  orderIndex Int
  text       String   @db.Text
  devChecked Boolean  @default(false) /// 開發端在 Markdown 標記的 [x]
  feedback   DesignChangeItemFeedback[]
  documents  DesignChangeDocument[]

  @@index([revisionId])
  @@map("design_change_checklist_items")
}

/// 需求方對每一條 checklist 的回應（確認 / 有問題 / 疑慮 + 說明）
model DesignChangeItemFeedback {
  id         String        @id @default(cuid())
  itemId     String
  item       DesignChangeChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User          @relation("DCItemReviewer", fields: [reviewerId], references: [id])
  mark       ChecklistMark @default(PENDING)
  comment    String?       @db.Text /// 問題點說明（非確認時填）
  updatedAt  DateTime      @updatedAt

  @@unique([itemId, reviewerId])
  @@index([itemId])
  @@map("design_change_item_feedback")
}

/// 審核人對整個版本的裁決（通過 / 駁回 + 總回應）
model DesignChangeReview {
  id         String             @id @default(cuid())
  revisionId String
  revision   DesignChangeRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User               @relation("DCReviewer", fields: [reviewerId], references: [id])
  role       String             /// REQUESTER / MANAGER / BOARD
  decision   DesignChangeStatus @default(PENDING)
  comment    String?            @db.Text
  decidedAt  DateTime?

  @@unique([revisionId, reviewerId])
  @@index([revisionId])
  @@map("design_change_reviews")
}

/// 設計變更附件（綁定版本快照；同一份檔可用 docGroup + fileVersion 換版回溯）
model DesignChangeDocument {
  id           String   @id @default(cuid())
  revisionId   String
  revision     DesignChangeRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String?  @db.Text
  fileSize     Int?
  docGroup     String?  /// 同一份邏輯檔案的版本群組（null = 獨立檔）
  fileVersion  Int      @default(1)
  checklistItemId String? /// 綁定到某一條 checklist（null = 版本層級附件）
  checklistItem   DesignChangeChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User     @relation("DCDocUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([revisionId])
  @@index([docGroup])
  @@index([checklistItemId])
  @@map("design_change_documents")
}

/// 需求分享短網址
model DemandShare {
  id          String   @id @default(cuid())
  demandId    String
  demand      Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  token       String   @unique /// nanoid 短碼 (12 字元)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  expiresAt   DateTime /// 建立時 +7 天
  createdAt   DateTime @default(now())

  @@index([demandId])
  @@map("demand_shares")
}

/// 組織郵件設定
model EmailSetting {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  signoffCcList   String?      @db.Text /// JSON array: ["a@b.com","c@d.com"]
  accountingEmail String?
  reportSendDay   Int          @default(5) /// 每月幾號寄報表 (1-28)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("email_settings")
}

/// 郵件發送紀錄
model MailLog {
  id           String        @id @default(cuid())
  type         MailLogType
  status       MailLogStatus
  toAddresses  String        @db.Text /// JSON array
  ccAddresses  String?       @db.Text /// JSON array
  subject      String
  errorMessage String?       @db.Text
  demandId     String?
  demand       Demand?       @relation(fields: [demandId], references: [id], onDelete: SetNull)
  sentById     String?
  sentBy       User?         @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("mail_logs")
}

/// 外部 API 金鑰
model ApiKey {
  id          String    @id @default(cuid())
  keyHash     String    @unique @map("key_hash") /// SHA-256 hash of the full key
  prefix      String                              /// 前 8 碼供顯示
  name        String                              /// 用途名稱
  createdById String    @map("created_by_id")
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  @@index([keyHash])
  @@map("api_keys")
}
