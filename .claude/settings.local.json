{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm dev:*)",
      "Bash(timeout 8 tail:*)",
      "Bash(npx tsc:*)",
      "Bash(npm install)",
      "Bash(npm run dev:*)",
      "Bash(taskkill:*)",
      "Bash(npx kill-port:*)",
      "Bash(rm:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint)",
      "Bash(npx next build:*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
